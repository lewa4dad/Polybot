/**
 * HFT Execution Engine
 * The core loop: fetches order books, runs the model,
 * evaluates edges, manages orders, and handles position lifecycle.
 */

import logger from "./logger.js";
import { FairValueModel } from "./model.js";

const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));

export class Engine {
  constructor({ client, riskManager, config }) {
    this.client = client;
    this.risk = riskManager;
    this.config = config;
    this.model = new FairValueModel();

    this.markets = []; // populated after fetchMarkets()
    this.prices = new Map(); // conditionId -> { yes, no, spread, vol }
    this.running = false;
    this.tickCount = 0;
    this.lastStatsLog = 0;

    // Track which markets we've warmed up enough to trade
    this.warmupDone = new Set();
    this.WARMUP_TICKS = 6;
    this.warmupCounts = new Map();
  }

  // ── Market Discovery ───────────────────────────────────────────────────────
  async fetchMarkets() {
    const markets = await this.client.fetchBTCMarkets();
    if (markets.length === 0) {
      logger.warn("No BTC markets found — will retry on next cycle");
      return;
    }
    this.markets = markets.filter(
      (m) => m.active && m.volume > 5000 // skip low-liquidity markets
    );
    logger.info(`Loaded ${this.markets.length} tradeable BTC markets`);
    this.markets.forEach((m) => logger.debug(`  → ${m.question} (vol: $${m.volume.toLocaleString()})`));
  }

  // ── Per-tick market data refresh ──────────────────────────────────────────
  async refreshPrices() {
    const tasks = this.markets.map(async (m) => {
      try {
        // Get YES token (index 0) and NO token (index 1) from tokens array
        const yesToken = m.tokens?.[0]?.token_id || m.conditionId;
        const noToken = m.tokens?.[1]?.token_id;

        const [book, spread] = await Promise.all([
          this.client.fetchOrderBook(yesToken),
          this.client.fetchSpread(yesToken),
        ]);

        if (!book) return;

        const bestBid = parseFloat(book.bids?.[0]?.price || 0);
        const bestAsk = parseFloat(book.asks?.[0]?.price || 1);
        const mid = (bestBid + bestAsk) / 2;
        const spreadVal = bestAsk - bestBid;

        if (mid <= 0 || mid >= 1) return;

        const prev = this.prices.get(m.conditionId);
        this.prices.set(m.conditionId, {
          yes: +mid.toFixed(5),
          no: +(1 - mid).toFixed(5),
          bestBid,
          bestAsk,
          spread: +spreadVal.toFixed(5),
          vol: m.volume,
          yesToken,
          noToken,
          book,
        });

        // Feed into model
        this.model.update(m.conditionId, mid, m.volume);

        // Track warmup
        const wc = (this.warmupCounts.get(m.conditionId) || 0) + 1;
        this.warmupCounts.set(m.conditionId, wc);
        if (wc >= this.WARMUP_TICKS) this.warmupDone.add(m.conditionId);

      } catch (err) {
        logger.debug(`Price refresh failed for ${m.conditionId}: ${err.message}`);
      }
    });

    await Promise.allSettled(tasks);
  }

  // ── Signal evaluation and order placement ─────────────────────────────────
  async evaluateAndTrade() {
    const { minEdge, spreadBuffer, kellyFraction, maxPositionPct } = this.config;

    for (const market of this.markets) {
      const cid = market.conditionId;
      const px = this.prices.get(cid);

      if (!px) continue;
      if (!this.warmupDone.has(cid)) continue; // still warming up

      const fair = this.model.compute(cid, px.yes);

      // ── Evaluate YES side ────────────────────────────────────────────────
      const edgeYes = this.model.edge(fair, px.bestAsk, "YES");
      if (edgeYes > minEdge + spreadBuffer) {
        const kellyF = this.model.kelly(edgeYes, px.bestAsk, kellyFraction, maxPositionPct);
        const size = +(this.risk.bankroll * kellyF).toFixed(2);

        if (this.risk.canTrade(cid, "YES", size)) {
          logger.info(`SIGNAL YES | ${market.question.slice(0, 40)} | edge=${(edgeYes * 100).toFixed(2)}% fair=${fair.toFixed(4)} ask=${px.bestAsk} size=$${size}`);

          const order = await this.client.placeOrder({
            tokenId: px.yesToken,
            side: "BUY",
            price: px.bestAsk,
            size,
          });

          if (order) {
            this.risk.openPosition({
              conditionId: cid,
              tokenId: px.yesToken,
              side: "YES",
              price: px.bestAsk,
              size,
              orderId: order.orderID || order.dry_run ? "DRY_RUN" : null,
              question: market.question,
            });
          }
        }
      }

      // ── Evaluate NO side ─────────────────────────────────────────────────
      const edgeNo = this.model.edge(fair, px.bestBid, "NO");
      if (edgeNo > minEdge + spreadBuffer) {
        const noAsk = 1 - px.bestBid; // NO ask = 1 - YES bid
        const kellyF = this.model.kelly(edgeNo, noAsk, kellyFraction, maxPositionPct);
        const size = +(this.risk.bankroll * kellyF).toFixed(2);

        if (this.risk.canTrade(cid, "NO", size)) {
          logger.info(`SIGNAL NO  | ${market.question.slice(0, 40)} | edge=${(edgeNo * 100).toFixed(2)}% fair=${(1 - fair).toFixed(4)} ask=${noAsk.toFixed(4)} size=$${size}`);

          const noToken = px.noToken || cid;
          const order = await this.client.placeOrder({
            tokenId: noToken,
            side: "BUY",
            price: noAsk,
            size,
          });

          if (order) {
            this.risk.openPosition({
              conditionId: cid,
              tokenId: noToken,
              side: "NO",
              price: noAsk,
              size,
              orderId: order.orderID || "DRY_RUN",
              question: market.question,
            });
          }
        }
      }

      // ── Check for exit signals on existing positions ──────────────────────
      await this.evaluateExits(market, px, fair);
    }
  }

  // ── Exit logic ─────────────────────────────────────────────────────────────
  async evaluateExits(market, px, fair) {
    const cid = market.conditionId;

    for (const side of ["YES", "NO"]) {
      const key = `${cid}_${side}`;
      const pos = this.risk.positions.get(key);
      if (!pos) continue;

      const currentPrice = side === "YES" ? px.bestBid : 1 - px.bestAsk;
      const unrealized = pos.shares * (currentPrice - pos.avgCost);
      const unrealizedPct = unrealized / pos.size;

      const heldMs = Date.now() - pos.openedAt;
      const heldMin = heldMs / 60000;

      const fairCurrent = side === "YES" ? fair : 1 - fair;
      const edgeNow = fairCurrent - currentPrice;

      const shouldClose =
        unrealizedPct >= 0.06 ||           // take profit at 6%
        unrealizedPct <= -0.04 ||          // stop loss at 4%
        (edgeNow < 0 && heldMin > 5) ||   // edge flipped + held 5min
        heldMin > 60;                      // max hold time 1 hour

      if (shouldClose) {
        const reason =
          unrealizedPct >= 0.06 ? "TAKE_PROFIT" :
          unrealizedPct <= -0.04 ? "STOP_LOSS" :
          edgeNow < 0 ? "EDGE_FLIP" : "MAX_HOLD";

        logger.info(`EXIT ${side} | ${reason} | pnl ${unrealized >= 0 ? "+" : ""}$${unrealized.toFixed(2)}`);
        this.risk.closePosition(cid, side, currentPrice);

        // Cancel any open orders on this market
        if (pos.orderId && pos.orderId !== "DRY_RUN") {
          await this.client.cancelOrder(pos.orderId).catch(() => {});
        }
      }
    }
  }

  // ── Periodic stats log ────────────────────────────────────────────────────
  logStats() {
    const now = Date.now();
    if (now - this.lastStatsLog < 30000) return; // every 30s
    this.lastStatsLog = now;

    const s = this.risk.stats(this.prices);
    logger.info(
      `📊 STATS | bankroll=$${s.bankroll} | realizedPnl=${s.realizedPnl >= 0 ? "+" : ""}$${s.realizedPnl} | ` +
      `unrealized=${s.unrealizedPnl >= 0 ? "+" : ""}$${s.unrealizedPnl} | ` +
      `positions=${s.openPositions} | trades=${s.totalTrades} | winRate=${(s.winRate * 100).toFixed(1)}% | ` +
      `drawdown=${(s.drawdown * 100).toFixed(1)}%`
    );
  }

  // ── Main tick ─────────────────────────────────────────────────────────────
  async tick() {
    if (!this.running) return;
    this.tickCount++;

    try {
      // Refresh market list every 5 minutes (300 ticks at 1s)
      if (this.tickCount % 300 === 1) {
        await this.fetchMarkets();
      }

      await this.refreshPrices();
      await this.evaluateAndTrade();
      this.logStats();
    } catch (err) {
      logger.error(`Tick error: ${err.message}`);
    }
  }

  // ── Start / Stop ──────────────────────────────────────────────────────────
  async start() {
    this.running = true;
    logger.info("⚡ HFT Engine starting...");

    await this.fetchMarkets();

    if (this.markets.length === 0) {
      logger.error("No markets available. Exiting.");
      process.exit(1);
    }

    const tickMs = this.config.tickMs;
    logger.info(`🔄 Tick rate: ${tickMs}ms | warming up for ${this.WARMUP_TICKS} ticks before trading`);

    this._interval = setInterval(() => this.tick(), tickMs);

    // Run first tick immediately
    await this.tick();
  }

  stop() {
    this.running = false;
    if (this._interval) clearInterval(this._interval);
    logger.info("Engine stopped");

    // Final stats
    const s = this.risk.stats(this.prices);
    logger.info(`Final PnL: $${s.totalPnl} | Trades: ${s.totalTrades} | Win rate: ${(s.winRate * 100).toFixed(1)}%`);
  }
}
